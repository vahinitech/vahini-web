#
# Template for the Cloudflare API token certbot-dns-cloudflare needs to create
# the temporary _acme-challenge TXT record for wildcard cert issuance/renewal.
#
# 1. In the Cloudflare dashboard: My Profile -> API Tokens -> Create Token ->
#    "Edit zone DNS" template, scoped to ONLY the vahinitech.com zone. Do NOT
#    use your Global API Key -- a scoped token limits the blast radius if it
#    ever leaks (it can only edit DNS for this one zone, nothing else).
# 2. Copy this file to /etc/letsencrypt/cloudflare.ini on the host and fill
#    in the real token.
# 3. chmod 600 /etc/letsencrypt/cloudflare.ini -- certbot refuses to run
#    (correctly) if this file is group/world readable.
# 4. Never commit the filled-in version of this file anywhere.

dns_cloudflare_api_token = REPLACE_WITH_YOUR_SCOPED_CLOUDFLARE_API_TOKEN
