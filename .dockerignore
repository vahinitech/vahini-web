# Keep the image small: ship only what the static site needs.
.git
.gitignore
Dockerfile
.dockerignore
docker-compose.yml
.venv/
venv/
**/__pycache__/
*.pyc
README.md
docs/
# The analyser submodule now serves itself entirely (frontend + API) from the
# analyser container (see deploy/docker-compose*.yml) -- the web/nginx image
# never needs its files, it only reverse-proxies to it.
analyser/
tests/
!tests/
tests/*
!tests/smoke-http.mjs
samples/
archive/
screenshots/
# Remotion video source (not served, no runtime dependency on the site).
site/video-src/
uploads/
shots/
scraps/
.thumbnail
.image-slots.state.json
*.md
